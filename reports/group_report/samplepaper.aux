\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Comparison of total rescheduling times, $T_{\mathrm  {res}}$, for Secondary + heuristic and Secondary without heuristic. The difference is computed as $\Delta T_{\mathrm  {res}} = T_{\mathrm  {res}}^{\mathrm  {Secondary+heuristic}} - T_{\mathrm  {res}}^{\mathrm  {Secondary,\ no\ heuristic}}$. Positive values indicate that using the heuristic is faster than without the heuristic.}}{10}{table.caption.17}\protected@file@percent }
\newlabel{tab:rescheduling_times_heuristic}{{2}{10}{Comparison of total rescheduling times, $T_{\mathrm {res}}$, for Secondary + heuristic and Secondary without heuristic. The difference is computed as $\Delta T_{\mathrm {res}} = T_{\mathrm {res}}^{\mathrm {Secondary+heuristic}} - T_{\mathrm {res}}^{\mathrm {Secondary,\ no\ heuristic}}$. Positive values indicate that using the heuristic is faster than without the heuristic}{table.caption.17}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Comparison of total rescheduling times, $T_{\mathrm  {res}}$, for Base and Secondary + time prioritization. The difference is computed as $\Delta T_{\mathrm  {res}} = T_{\mathrm  {res}}^{\mathrm  {Secondary+time\ priority}} - T_{\mathrm  {res}}^{\mathrm  {Base}}$. Positive values indicate that Base is faster.}}{11}{table.caption.18}\protected@file@percent }
\newlabel{tab:rescheduling_time_prioritization}{{3}{11}{Comparison of total rescheduling times, $T_{\mathrm {res}}$, for Base and Secondary + time prioritization. The difference is computed as $\Delta T_{\mathrm {res}} = T_{\mathrm {res}}^{\mathrm {Secondary+time\ priority}} - T_{\mathrm {res}}^{\mathrm {Base}}$. Positive values indicate that Base is faster}{table.caption.18}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Comparison of total rescheduling times, $T_{\mathrm  {res}}$, for Secondary + heuristic and Secondary + time priority. The difference is computed as $\Delta T_{\mathrm  {res}} = T_{\mathrm  {res}}^{\mathrm  {Secondary+time\ priority}} - T_{\mathrm  {res}}^{\mathrm  {Secondary+heuristic}}$. Positive values indicate that Secondary + heuristic is faster.}}{12}{table.caption.19}\protected@file@percent }
\newlabel{tab:rescheduling_time_priority}{{4}{12}{Comparison of total rescheduling times, $T_{\mathrm {res}}$, for Secondary + heuristic and Secondary + time priority. The difference is computed as $\Delta T_{\mathrm {res}} = T_{\mathrm {res}}^{\mathrm {Secondary+time\ priority}} - T_{\mathrm {res}}^{\mathrm {Secondary+heuristic}}$. Positive values indicate that Secondary + heuristic is faster}{table.caption.19}{}}
