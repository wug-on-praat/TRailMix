\newlabel{tab:rescheduling_time_prioritization}{{3}{12}{Comparison of total rescheduling times, $T_{\mathrm {res}}$, for Base and Secondary + time prioritization. The difference is computed as $\Delta T_{\mathrm {res}} = T_{\mathrm {res}}^{\mathrm {Secondary+time\ priority}} - T_{\mathrm {res}}^{\mathrm {Base}}$. Positive values indicate that Base is faster}{table.caption.21}{}}
